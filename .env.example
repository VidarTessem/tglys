# tglys — environment configuration
# Copy this file to .env and fill in your values.

# URL that returns JSON containing "trafikklys": "red" | "yellow" | "green"
# The endpoint may return a single JSON object or a JSON array of objects.
TGLYS_URL=https://example.com/api/trafikklys

# How often to poll the URL (in seconds). Default: 30
TGLYS_POLL_INTERVAL=30

# System master volume (0–100) for each traffic-light state.
TGLYS_RED_VOLUME=0
TGLYS_YELLOW_VOLUME=50
TGLYS_GREEN_VOLUME=100
